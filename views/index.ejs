    border: 1px solid rgba(255,255,255,0.06) !important;
    border-radius: 999px !important;
    padding: 0 8px !important;
    height: 24px !important;
    flex-shrink: 1 !important;
    min-width: 0 !important;
    overflow: hidden !important;
}

.status-pulse-dot {
    width: 5px !important;
    height: 5px !important;
    border-radius: 50% !important;
    background: #34d399 !important;
    box-shadow: 0 0 4px rgba(52,211,153,0.5) !important;
    flex-shrink: 0 !important;
    display: inline-block !important;
}
.status-pulse-dot.offline { background: #52525b !important; box-shadow: none !important; }
.status-pulse-dot.ringing {
    background: #fbbf24 !important;
    animation: svPulse 0.6s infinite alternate ease-in-out !important;
}
@keyframes svPulse {
    from { transform: scale(0.8); opacity: 0.4; }
    to { transform: scale(1.3); opacity: 1; }
}

.compact-ext-select {
    background: transparent !important;
    border: none !important;
    color: rgba(255,255,255,0.85) !important;
    font-size: 10px !important;
    font-weight: 700 !important;
    outline: none !important;
    cursor: pointer !important;
    padding: 0 !important;
    min-width: 0 !important;
    max-width: 72px !important;
}

.compact-connect-btn {
    background: none !important;
    border: none !important;
    color: #34d399 !important;
    font-size: 9px !important;
    font-weight: 800 !important;
    cursor: pointer !important;
    padding: 0 2px !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
}
.compact-connect-btn.btn-danger { color: #f87171 !important; }

.titlebar-actions {
    display: flex !important;
    align-items: center !important;
    gap: 1px !important;
    flex-shrink: 0 !important;
}

.titlebar-btn {
    width: 26px !important;
    height: 26px !important;
    background: none !important;
    border: none !important;
    border-radius: 6px !important;
    color: rgba(255,255,255,0.3) !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 !important;
    transition: color 0.12s, background 0.12s !important;
}
.titlebar-btn:hover {
    color: rgba(255,255,255,0.8) !important;
    background: rgba(255,255,255,0.06) !important;
}

/* ── SEGMENTED NAV ── */
.sub-nav-tabs {
    display: flex !important;
    background: rgba(255,255,255,0.03) !important;
    border: none !important;
    border-bottom: 1px solid rgba(255,255,255,0.04) !important;
    border-radius: 0 !important;
    padding: 3px 12px !important;
    gap: 2px !important;
    margin: 0 !important;
    min-height: auto !important;
    width: 100% !important;
}

.sub-nav-tab {
    flex: 1 !important;
    height: 26px !important;
    background: transparent !important;
    border: none !important;
    border-radius: 8px !important;
    color: rgba(255,255,255,0.35) !important;
    font-size: 10.5px !important;
    font-weight: 600 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 5px !important;
    cursor: pointer !important;
    transition: all 0.15s ease !important;
    padding: 0 !important;
    box-shadow: none !important;
    min-width: 0 !important;
}
.sub-nav-tab span {
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
}
.sub-nav-tab svg {
    opacity: 0.5 !important;
    transition: opacity 0.15s !important;
}
.sub-nav-tab:hover {
    color: rgba(255,255,255,0.6) !important;
    background: rgba(255,255,255,0.03) !important;
    border-color: transparent !important;
}
.sub-nav-tab.active {
    background: rgba(52,211,153,0.1) !important;
    color: #34d399 !important;
    font-weight: 700 !important;
    box-shadow: none !important;
    border-color: transparent !important;
}
.sub-nav-tab.active svg {
    opacity: 1 !important;
}

.workspace {
    background: transparent !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    flex: 1 !important;
    min-height: 0 !important;
    display: flex !important;
    flex-direction: column !important;
}

/* Center dialer content vertically in the viewport */
#tabContentDialer.active {
    flex: 1 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
}
#tabContentDialer .dialer-col {
    flex: none !important;
    height: auto !important;
}
.workspace-header { display: none !important; }

.tab-view-content {
    padding: 6px 16px 6px !important;
}

.dialer-col {
    gap: 0 !important;
    max-width: 340px !important;
}

/* ── DIAL INPUT ── */
.dialer-input-box {
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    border-bottom: 1px solid rgba(255,255,255,0.06) !important;
    padding: 2px 2px !important;
    height: auto !important;
    margin-bottom: 6px !important;
    box-shadow: none !important;
    transition: border-color 0.12s !important;
    display: flex !important;
    align-items: center !important;
}
.dialer-input-box:focus-within {
    border-color: rgba(52,211,153,0.3) !important;
    box-shadow: none !important;
    background: transparent !important;
}

.dialer-input {
    font-size: 22px !important;
    font-weight: 300 !important;
    color: #ffffff !important;
    letter-spacing: 0.03em !important;
    text-align: center !important;
    background: transparent !important;
    border: none !important;
    outline: none !important;
    width: 100% !important;
    font-variant-numeric: tabular-nums !important;
    font-family: var(--font-main) !important;
}
.dialer-input::placeholder {
    color: rgba(255,255,255,0.15) !important;
    font-size: 24px !important;
    font-weight: 300 !important;
}

.dial-history-dropdown-btn {
    background: none !important;
    border: none !important;
    color: rgba(255,255,255,0.2) !important;
    cursor: pointer !important;
    padding: 4px !important;
    display: flex !important;
    align-items: center !important;
    gap: 2px !important;
    border-radius: 4px !important;
    flex-shrink: 0 !important;
}
.dial-history-dropdown-btn:hover { color: rgba(255,255,255,0.5) !important; }

.clear-input-btn {
    background: none !important;
    border: none !important;
    color: rgba(255,255,255,0.2) !important;
    cursor: pointer !important;
    padding: 6px !important;
    border-radius: 50% !important;
    flex-shrink: 0 !important;
    display: flex !important;
    align-items: center !important;
}
.clear-input-btn:hover { color: rgba(255,255,255,0.6) !important; }

/* ── CIRCULAR KEYPAD ── */
.keypad-grid {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 6px !important;
    margin-bottom: 8px !important;
    justify-items: center !important;
    padding: 0 8px !important;
}

.keypad-btn {
    width: 58px !important;
    height: 58px !important;
    min-height: 0 !important;
    background: rgba(255,255,255,0.06) !important;
    border: none !important;
    border-radius: 50% !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    user-select: none !important;
    padding: 0 !important;
    gap: 1px !important;
    box-shadow: none !important;
    transition: background 0.1s ease, transform 0.08s ease !important;
    position: relative !important;
    overflow: hidden !important;
    isolation: isolate !important;
}
.keypad-btn::before {
    content: "" !important;
    position: absolute !important;
    inset: 0 !important;
    z-index: -1 !important;
    border-radius: 50% !important;
    background: rgba(255,255,255,0.12) !important;
    transform: scale(0) !important;
    transition: transform 0.25s cubic-bezier(0.16,1,0.3,1) !important;
}
.keypad-btn:hover::before {
    transform: scale(1) !important;
}
.keypad-btn:hover {
    border-color: transparent !important;
}
.keypad-btn:active {
    transform: scale(0.92) !important;
    background: rgba(255,255,255,0.15) !important;
    border-color: transparent !important;
}

.keypad-digit {
    font-size: 20px !important;
    font-weight: 400 !important;
    color: #ffffff !important;
    line-height: 1 !important;
    font-family: var(--font-main) !important;
}

.keypad-sub {
    font-size: 7px !important;
    font-weight: 600 !important;
    color: rgba(255,255,255,0.35) !important;
    letter-spacing: 0.15em !important;
    margin-top: 2px !important;
    text-transform: uppercase !important;
    line-height: 1 !important;
    font-family: var(--font-main) !important;
}

/* ── ACTION ROW ── */
.keypad-action-row {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 14px !important;
    margin-bottom: 6px !important;
    padding: 0 8px !important;
}

.call-pill-btn {
    width: 58px !important;
    height: 58px !important;
    flex: none !important;
    background: #10b981 !important;
    color: #fff !important;
    border: none !important;
    border-radius: 50% !important;
    font-size: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 0 !important;
    cursor: pointer !important;
    box-shadow: 0 4px 24px -4px rgba(16,185,129,0.5), 0 0 0 4px rgba(16,185,129,0.12) !important;
    transition: all 0.15s ease !important;
    position: relative !important;
    overflow: hidden !important;
    isolation: isolate !important;
    padding: 0 !important;
}
.call-pill-btn::before {
    content: "" !important;
    position: absolute !important;
    inset: 0 !important;
    z-index: -1 !important;
    border-radius: 50% !important;
    background: #059669 !important;
    transform: scale(0) !important;
    transition: transform 0.25s cubic-bezier(0.16,1,0.3,1) !important;
}
.call-pill-btn:hover::before {
    transform: scale(1) !important;
}
.call-pill-btn:hover:not(:disabled) {
    box-shadow: 0 6px 32px -4px rgba(16,185,129,0.6), 0 0 0 6px rgba(16,185,129,0.15) !important;
    transform: scale(1.05) !important;
}
.call-pill-btn:active:not(:disabled) {
    transform: scale(0.93) !important;
}
.call-pill-btn:disabled {
    background: rgba(255,255,255,0.06) !important;
    color: rgba(255,255,255,0.2) !important;
    box-shadow: none !important;
    cursor: not-allowed !important;
    opacity: 1 !important;
}
.call-pill-btn:disabled::before { display: none !important; }
.call-pill-btn span {
    display: none !important;
}
.call-pill-btn svg {
    stroke: #fff !important;
    width: 24px !important;
    height: 24px !important;
    position: relative !important;
    z-index: 2 !important;
    flex-shrink: 0 !important;
}
.call-pill-btn:disabled svg { stroke: rgba(255,255,255,0.2) !important; }

.call-aux-btn {
    width: 40px !important;
    height: 40px !important;
    background: rgba(255,255,255,0.06) !important;
    border: none !important;
    border-radius: 50% !important;
    color: rgba(255,255,255,0.5) !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    transition: all 0.1s ease !important;
    padding: 0 !important;
    gap: 3px !important;
    position: relative !important;
    overflow: hidden !important;
    isolation: isolate !important;
}
.call-aux-btn::before {
    content: "" !important;
    position: absolute !important;
    inset: 0 !important;
    z-index: -1 !important;
    border-radius: 50% !important;
    background: rgba(255,255,255,0.1) !important;
    transform: scale(0) !important;
    transition: transform 0.2s cubic-bezier(0.16,1,0.3,1) !important;
}
.call-aux-btn:hover::before { transform: scale(1) !important; }
.call-aux-btn:hover { color: rgba(255,255,255,0.85) !important; }
.call-aux-btn span {
    font-size: 6px !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
    color: inherit !important;
    position: relative !important;
    z-index: 2 !important;
}

/* ── UTILITY DOCK ── */
.dialer-tool-bar {
    display: flex !important;
    justify-content: center !important;
    gap: 6px !important;
    padding: 4px 0 2px !important;
    background: transparent !important;
    border: none !important;
    border-top: 1px solid rgba(255,255,255,0.04) !important;
    border-radius: 0 !important;
    margin-top: 0 !important;
    box-shadow: none !important;
}

.tool-icon-btn {
    width: 48px !important;
    height: 34px !important;
    background: transparent !important;
    border: none !important;
    border-radius: 10px !important;
    color: rgba(255,255,255,0.35) !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 2px !important;
    cursor: pointer !important;
    transition: all 0.12s ease !important;
    padding: 0 !important;
    position: relative !important;
    overflow: hidden !important;
    isolation: isolate !important;
}
.tool-icon-btn::before {
    content: "" !important;
    position: absolute !important;
    inset: 0 !important;
    z-index: -1 !important;
    background: rgba(255,255,255,0.06) !important;
    border-radius: 10px !important;
    transform: scale(0) !important;
    transition: transform 0.2s cubic-bezier(0.16,1,0.3,1) !important;
}
.tool-icon-btn:hover::before,
.tool-icon-btn:focus-visible::before {
    transform: scale(1) !important;
}
.tool-icon-btn .tool-label {
    font-size: 8px !important;
    font-weight: 700 !important;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
    line-height: 1 !important;
    color: inherit !important;
    position: relative !important;
    z-index: 2 !important;
}
.tool-icon-btn svg {
    position: relative !important;
    z-index: 2 !important;
}
.tool-icon-btn:not(:disabled):hover {
    color: rgba(255,255,255,0.75) !important;
}

/* Active states */
.tool-icon-btn.active-mute {
    background: rgba(248,113,113,0.08) !important;
    color: #f87171 !important;
    box-shadow: none !important;
}
.tool-icon-btn.active-hold {
    background: rgba(251,191,36,0.08) !important;
    color: #fbbf24 !important;
    box-shadow: none !important;
}
.tool-icon-btn.active-dnd {
    background: rgba(248,113,113,0.08) !important;
    color: #f87171 !important;
    box-shadow: none !important;
}
.tool-icon-btn.active-auto {
    background: rgba(52,211,153,0.08) !important;
    color: #34d399 !important;
    box-shadow: none !important;
}
.tool-icon-btn.active-speaker-mute {
    background: rgba(251,191,36,0.08) !important;
    color: #fbbf24 !important;
    box-shadow: none !important;
}

/* ── IN-CALL ── */
.app-window.is-in-call { max-height: calc(100vh - 24px) !important; }


/* ── Scrollbar ── */
::-webkit-scrollbar { width: 3px !important; }
::-webkit-scrollbar-track { background: transparent !important; }
::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08) !important; border-radius: 4px !important; }

/* ── Toast/notification ── */
.toast-container,
.toast-notification {
    background: rgba(14,14,18,0.95) !important;
    backdrop-filter: blur(12px) !important;
    border: 1px solid rgba(255,255,255,0.06) !important;
    border-radius: 10px !important;
    color: rgba(255,255,255,0.8) !important;
    font-size: 12px !important;
}

/* ── MicBanner ── */
#micBanner {
    background: rgba(251,191,36,0.06) !important;
    border: 1px solid rgba(251,191,36,0.15) !important;
    border-radius: 8px !important;
    padding: 6px 10px !important;
    margin: 0 !important;
    font-size: 11px !important;
    color: rgba(251,191,36,0.8) !important;
}

/* ── Modal ── */
.modal-tabs-container {
    background: rgba(14,14,18,0.98) !important;
    border: 1px solid rgba(255,255,255,0.06) !important;
    border-radius: 14px !important;
    backdrop-filter: blur(20px) !important;
}
.modal-tab-btn {
    background: transparent !important;
    border: none !important;
    color: rgba(255,255,255,0.4) !important;
    font-size: 11px !important;
    padding: 6px 12px !important;
    border-radius: 6px !important;
    cursor: pointer !important;
}
.modal-tab-btn.active {
    background: rgba(52,211,153,0.1) !important;
    color: #34d399 !important;
}

/* ── Popout ── */
.html.is-popout .app-window {
    max-width: 100% !important;
    border-radius: 0 !important;
    border: none !important;
}

/* ── Dial history dropdown ── */
.dial-history-dropdown-header {
    background: #0e0e12 !important;
    border-color: rgba(255,255,255,0.06) !important;
    color: rgba(255,255,255,0.5) !important;
    font-size: 10px !important;
    padding: 4px 8px !important;
}
.dial-history-dropdown-btn-hover,
.light-theme .dial-history-dropdown-btn:hover {
    background: rgba(255,255,255,0.04) !important;
}
.dial-history-name {
    font-size: 12px !important;
    color: rgba(255,255,255,0.8) !important;
}


/* Fix #connectBtn - the actual Disconnect button */
#connectBtn.btn.btn-danger {
    background: rgba(248,113,113,0.08) !important;
    color: rgba(248,113,113,0.65) !important;
    border: 1px solid rgba(248,113,113,0.12) !important;
    font-size: 8.5px !important;
    font-weight: 700 !important;
    padding: 2px 7px !important;
    border-radius: 4px !important;
    text-transform: uppercase !important;
    letter-spacing: 0.04em !important;
    box-shadow: none !important;
    min-height: 0 !important;
    line-height: 1.4 !important;
    transition: all 0.12s !important;
}
#connectBtn.btn.btn-danger:hover {
    background: rgba(248,113,113,0.15) !important;
    color: #f87171 !important;
}
#connectBtn.btn:not(.btn-danger) {
    background: rgba(52,211,153,0.08) !important;
    color: rgba(52,211,153,0.65) !important;
    border: 1px solid rgba(52,211,153,0.12) !important;
    font-size: 8.5px !important;
    font-weight: 700 !important;
    padding: 2px 7px !important;
    border-radius: 4px !important;
    text-transform: uppercase !important;
    letter-spacing: 0.04em !important;
    box-shadow: none !important;
    min-height: 0 !important;
    line-height: 1.4 !important;
}
#connectBtn.btn:not(.btn-danger):hover {
    background: rgba(52,211,153,0.15) !important;
    color: #34d399 !important;
}



    </style>
</head>
<body>
<!-- Toast Notification Container -->
    <div id="toastContainer" class="toast-container"></div>

    <!-- Hidden Remote Audio Element for Bidirectional Audio -->
    <audio id="remoteAudio" autoplay playsinline></audio>

    <!-- Multi-Window Take-Over Overlay -->
    <div id="takeOverOverlay" class="modal-backdrop hidden">
        <div class="modal-card text-center">
            <div style="font-size: 32px; margin-bottom: 8px;">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin:0 auto;"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            </div>
            <h3 style="font-size: 15px; font-weight: 800; margin-bottom: 6px;">
                <%= isRtl ? 'الهاتف نشط في نافذة أخرى' : 'Softphone Active in Another Window' %>
            </h3>
            <p style="font-size: 11px; color: var(--text-secondary); margin-bottom: 16px;">
                <%= isRtl ? 'يوجد اتصال نشط قيد التشغيل في علامة تبويب أخرى. للحفاظ على استقرار المكالمات، يتم تشغيل هاتف واحد فقط.' : 'An active softphone session is currently running in another browser tab. Only one session can register at a time.' %>
            </p>
            <button type="button" onclick="window.softphoneUi.core.takeOverOwnership()" class="btn btn-primary w-full">
                <%= isRtl ? 'سحب التحكم إلى هذه النافذة ↗' : 'Take Over Control ↗' %>
            </button>
        </div>
    </div>

    <!-- 1. DEDICATED SOFTPHONE LOGIN SCREEN -->
    <div id="loginView" class="app-window login-window" style="display: flex;">
        <!-- Titlebar -->
        <div class="app-titlebar">
            <div class="app-titlebar-title">
                <span>SOKRAT <span style="color: var(--accent-color);">VOICE</span></span>
            </div>
            <div class="titlebar-actions">
                <button type="button" onclick="window.softphoneUi.toggleTheme()" class="titlebar-btn" title="Toggle Light/Dark Theme">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                </button>
                <button type="button" onclick="window.softphoneUi.openPersistentWindow()" class="titlebar-btn" title="Open in Persistent Popout Window">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </button>
            </div>
        </div>

        <!-- Login Body -->
        <div class="login-body">
            <div class="login-header text-center">
                <div class="login-logo-container">
                    <img src="/logo.png" alt="Sokrat Voice" class="login-logo login-logo-dark" style="height: 38px; object-fit: contain; margin: 0 auto;">
                    <img src="/logo_dark.png" alt="Sokrat Voice" class="login-logo login-logo-light" style="height: 38px; object-fit: contain; margin: 0 auto; display: none;">
                </div>
                <h2 class="login-title"><%= isRtl ? 'تسجيل الدخول للهاتف' : 'WebRTC Softphone Login' %></h2>
                <p class="login-subtitle"><%= isRtl ? 'اختر تحويلة WebRTC وكلمة السر لبدء الاتصال' : 'Select a WebRTC extension and enter password' %></p>
            </div>

            <form id="loginForm" class="login-form" onsubmit="event.preventDefault(); window.softphoneUi.submitLogin();">
                <!-- Extension Selection & Input Mode -->
                <div class="login-field-group">
                    <div class="login-label-row">
                        <label class="login-label" for="loginExtSelect">
                            <%= isRtl ? 'تحويلة WebRTC (من السيرفر):' : 'WebRTC Extension (PBX):' %>
                        </label>
                        <div class="login-mode-pills">
                            <button type="button" id="loginModeSelectBtn" class="login-mode-pill active" onclick="window.softphoneUi.setLoginInputMode('select')">
                                <%= isRtl ? 'قائمة' : 'List' %>
                            </button>
                            <button type="button" id="loginModeManualBtn" class="login-mode-pill" onclick="window.softphoneUi.setLoginInputMode('manual')">
                                <%= isRtl ? 'يدوي' : 'Manual' %>
                            </button>
                        </div>
                    </div>

                    <!-- Select Dropdown Mode -->
                    <div id="loginFieldSelectWrapper" class="login-select-wrapper">
                        <select id="loginExtSelect" class="input-text font-mono font-bold w-full" onchange="window.softphoneUi.onLoginExtensionSelected()">
                            <option value=""><%= isRtl ? '-- اختر تحويلة WebRTC --' : '-- Select WebRTC Extension --' %></option>
                            <% (typeof extensions !== 'undefined' && Array.isArray(extensions) ? extensions : [{extension: '150', name: '150', tech: 'pjsip'}]).forEach(function(ext) { %>
                                <option value="<%= ext.extension %>" <%= (ext.extension === '150') ? 'selected' : '' %>>
                                    <%= (ext.name && ext.name !== ext.extension) ? (ext.extension + ' - ' + ext.name) : ('Ext ' + ext.extension) %> (<%= ext.tech || 'pjsip' %>)
                                </option>
                            <% }); %>
                        </select>
                    </div>

                    <!-- Manual Input Mode (Hidden by default) -->
                    <div id="loginFieldManualWrapper" class="login-manual-wrapper" style="display: none;">
                        <input type="text" id="loginExtInput" class="input-text font-mono font-bold w-full" placeholder="150" value="150">
                    </div>
                </div>

                <!-- Password Field with Show/Hide Toggle -->
                <div class="login-field-group">
                    <label class="login-label" for="loginPasswordInput">
                        <%= isRtl ? 'كلمة سر التحويلة:' : 'Extension Password:' %>
                    </label>
                    <div class="login-password-wrapper">
                        <input type="password" id="loginPasswordInput" class="input-text font-mono w-full" placeholder="••••••••" autocomplete="current-password">
                        <button type="button" id="loginPasswordToggleBtn" class="login-password-toggle" onclick="window.softphoneUi.toggleLoginPasswordVisibility()" title="Show/Hide Password">
                            <svg id="loginPassEyeIcon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                </div>

                <!-- Remember Me Row -->
                <div class="login-options-row">
                    <label class="login-checkbox-label">
                        <input type="checkbox" id="loginRememberCheckbox" checked style="accent-color: var(--accent-color);">
                        <span><%= isRtl ? 'حفظ الحساب للدخول السريع' : 'Remember credentials on this device' %></span>
                    </label>
                </div>

                <!-- Connect / Login Submit Button -->
                <button type="submit" id="loginSubmitBtn" class="btn btn-primary login-submit-btn w-full shutter-btn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    <span><%= isRtl ? 'تسجيل الدخول والاتصال ↗' : 'CONNECT & LOGIN ↗' %></span>
                </button>
            </form>

            <!-- Saved Accounts Quick Login Section -->
            <div class="login-saved-section">
                <div class="login-saved-header">
                    <span class="login-saved-title"><%= isRtl ? 'الحسابات المحفوظة' : 'SAVED ACCOUNTS' %></span>
                    <button type="button" class="login-action-btn" onclick="window.softphoneUi.openPresetModal()">
                        + <%= isRtl ? 'إدارة' : 'Manage' %>
                    </button>
                </div>
                <div id="loginSavedAccountsList" class="login-saved-list"></div>
            </div>
        </div>
    </div>

    <!-- 2. MAIN APP WINDOW CONTAINER (TELEPHONY CONSOLE) -->
    <div id="mainAppWindow" class="app-window" style="display: none;">
        
        <!-- Unified Modern Header (Single Aligned Row) -->
        <div class="app-titlebar">
            <div class="app-titlebar-title">
                <span>SOKRAT</span>
                <span class="brand-badge">VOICE</span>
            </div>

            <div class="header-status-strip">
                <span id="statusPulseDot" class="status-pulse-dot"></span>
                <select id="presetSelect" class="compact-ext-select" onchange="window.softphoneUi.onPresetChanged()">
                    <% (typeof extensions !== 'undefined' && Array.isArray(extensions) ? extensions : [{extension: '150', name: '150', tech: 'pjsip'}]).forEach(function(ext) { %>
                        <option value="ext_<%= ext.extension %>" <%= (ext.extension === '150') ? 'selected' : '' %>>
                            Ext <%= ext.extension %>
                        </option>
                    <% }); %>
                </select>
                <button type="button" id="connectBtn" class="compact-connect-btn">
                    <%= isRtl ? 'اتصال' : 'Connect' %>
                </button>
                <div id="statusBadge" style="display: none;"><span id="statusText"><%= isRtl ? 'غير متصل' : 'Offline' %></span></div>
            </div>

            <div class="titlebar-actions">
                <button type="button" class="titlebar-btn" onclick="window.softphoneUi.openPresetModal()" title="<%= isRtl ? 'إدارة الحسابات' : 'Accounts' %>">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </button>
                <button type="button" class="titlebar-btn" onclick="window.softphoneUi.openAudioModal()" title="<%= isRtl ? 'إعدادات الصوت' : 'Audio Settings' %>">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path></svg>
                </button>
                <button type="button" onclick="window.softphoneUi.toggleTheme()" class="titlebar-btn" title="Toggle Light/Dark Theme">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                </button>
            </div>
        </div>

        <!-- Main Window Body (50% / 50% Dual Consoles) -->
        <div class="app-body">
            <!-- MAIN LINE 1 WORKSPACE CONTENT -->
            <div class="workspace" id="line1Workspace">

                <!-- Microphone Permission Alert Banner -->
                <div id="micBanner" style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); padding: 8px 12px; margin-bottom: 10px; display: none; align-items: center; justify-content: space-between;">
                    <div style="font-size: 11px; font-weight: 700; color: #fbbf24; display: flex; align-items: center; gap: 6px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
                        <span><%= isRtl ? 'إذن الميكروفون مطلوب لإجراء واستقبال المكالمات.' : 'Microphone permission required for voice calls.' %></span>
                    </div>
                    <button type="button" onclick="window.softphoneUi.core.acquireMicrophone()" class="btn btn-primary" style="padding: 4px 10px; font-size: 10px;">
                        <%= isRtl ? 'السماح' : 'Grant' %>
                    </button>
                </div>

                <!-- Sub Navigation Top Bar -->
                <div class="sub-nav-tabs">
                    <button type="button" class="sub-nav-tab active" id="tabBtnDialer" onclick="window.softphoneUi.switchTab('dialer')">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        <span><%= isRtl ? 'لوحة الاتصال' : 'Dialer' %></span>
                    </button>
                    <button type="button" class="sub-nav-tab" id="tabBtnContacts" onclick="window.softphoneUi.switchTab('contacts')">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <span><%= isRtl ? 'جهات الاتصال' : 'Contacts' %></span>
                    </button>
                    <button type="button" class="sub-nav-tab" id="tabBtnHistory" onclick="window.softphoneUi.switchTab('history')">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        <span><%= isRtl ? 'سجل المكالمات' : 'Recent Calls' %></span>
                    </button>
                </div>

                <!-- Active Calls Hero Display Container (Pinned & Always Visible in Calls) -->
                <div id="activeCallContainer" style="display: none; flex-direction: column; padding: 10px 14px 0;"></div>

                <!-- Tab View: Dialer -->
                <div id="tabContentDialer" class="tab-view-content active">
                    <div class="dialer-col" style="max-width: 480px; margin: 0 auto;">
                        

                        <!-- LCD Dial Display Box -->
                        <div class="dialer-input-box" style="position: relative;">
                            <button type="button" id="dialHistoryDropdownBtn" class="dial-history-dropdown-btn" onclick="window.softphoneUi.toggleDialHistoryDropdown()" title="<%= isRtl ? 'الأرقام المطلوبة سابقاً' : 'Previously Dialed Numbers' %>">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                            </button>
                            <input type="text" id="dialInput" placeholder="1-555-0199" class="dialer-input" autocomplete="off">
                            <button type="button" class="clear-input-btn" onclick="document.getElementById('dialInput').value = document.getElementById('dialInput').value.slice(0, -1)" title="Backspace">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 4H8l-7 8 7 8h13a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"/><line x1="18" y1="9" x2="12" y2="15"/><line x1="12" y1="9" x2="18" y2="15"/></svg>
                            </button>

                            <!-- Dropdown List of Previously Dialed Numbers -->
                            <div id="dialHistoryDropdown" class="dial-history-dropdown" style="display: none;">
                                <div class="dial-history-dropdown-header">
                                    <span><%= isRtl ? 'الأرقام المطلوبة مؤخراً' : 'RECENTLY DIALED' %></span>
                                    <button type="button" class="dial-history-close-btn" onclick="window.softphoneUi.closeDialHistoryDropdown()">✕</button>
                                </div>
                                <div id="dialHistoryDropdownList" class="dial-history-dropdown-list"></div>
                            </div>
                        </div>

                        <!-- 3x4 Modern Squircle Keypad Grid with DTMF Labels -->
                        <div class="keypad-grid" id="keypadGrid">
                            <button type="button" class="keypad-btn" data-digit="1"><span class="keypad-digit">1</span><span class="keypad-sub"></span></button>
                            <button type="button" class="keypad-btn" data-digit="2"><span class="keypad-digit">2</span><span class="keypad-sub">ABC</span></button>
                            <button type="button" class="keypad-btn" data-digit="3"><span class="keypad-digit">3</span><span class="keypad-sub">DEF</span></button>
                            <button type="button" class="keypad-btn" data-digit="4"><span class="keypad-digit">4</span><span class="keypad-sub">GHI</span></button>
                            <button type="button" class="keypad-btn" data-digit="5"><span class="keypad-digit">5</span><span class="keypad-sub">JKL</span></button>
                            <button type="button" class="keypad-btn" data-digit="6"><span class="keypad-digit">6</span><span class="keypad-sub">MNO</span></button>
                            <button type="button" class="keypad-btn" data-digit="7"><span class="keypad-digit">7</span><span class="keypad-sub">PQRS</span></button>
                            <button type="button" class="keypad-btn" data-digit="8"><span class="keypad-digit">8</span><span class="keypad-sub">TUV</span></button>
                            <button type="button" class="keypad-btn" data-digit="9"><span class="keypad-digit">9</span><span class="keypad-sub">WXYZ</span></button>
                            <button type="button" class="keypad-btn" data-digit="*"><span class="keypad-digit">*</span><span class="keypad-sub"></span></button>
                            <button type="button" class="keypad-btn" data-digit="0"><span class="keypad-digit">0</span><span class="keypad-sub">+</span></button>
                            <button type="button" class="keypad-btn" data-digit="#"><span class="keypad-digit">#</span><span class="keypad-sub"></span></button>
                        </div>

                        <!-- Action Buttons: Call & Clear -->
                        <div class="keypad-action-row">
                            <button type="button" id="callBtn" class="call-pill-btn" title="Place Call">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                                <span><%= isRtl ? 'اتصال' : 'Call' %></span>
                            </button>
                            <button type="button" class="call-aux-btn" onclick="document.getElementById('dialInput').value=''" title="Clear">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                <span><%= isRtl ? 'مسح' : 'Clear' %></span>
                            </button>
                        </div>

                                                <!-- Live In-Call & Toggle Tools Bar (With Sokrat Hardware Controls & State Glows) -->
                        <div class="dialer-tool-bar">
                            <button type="button" class="tool-icon-btn" id="toolBtnSpeakerMute" onclick="window.softphoneUi.toggleSpeakerMute()" title="<%= isRtl ? 'كتم صوت السماعة' : 'Mute Speaker Audio' %>">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path></svg>
                                <span class="tool-label"><%= isRtl ? 'سماعة' : 'Speaker' %></span>
                            </button>
                            <button type="button" class="tool-icon-btn" id="toolBtnDnd" onclick="window.softphoneUi.toggleDndButton()" title="<%= isRtl ? 'وضع عدم الإزعاج' : 'Do Not Disturb (DND)' %>">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                                <span class="tool-label"><%= isRtl ? 'إزعاج' : 'DND' %></span>
                            </button>
                            <button type="button" class="tool-icon-btn" id="toolBtnAuto" onclick="window.softphoneUi.toggleAutoAnswerButton()" title="<%= isRtl ? 'الرد التلقائي' : 'Auto Answer' %>">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                                <span class="tool-label"><%= isRtl ? 'تلقائي' : 'Auto' %></span>
                            </button>
                        </div>

                        <input type="checkbox" id="dndCheckbox" style="display: none;">
                        <input type="checkbox" id="autoAnswerCheckbox" style="display: none;">


                    </div>
                </div>

                <!-- Tab View: Contacts -->
                <div id="tabContentContacts" class="tab-view-content">
                    <div id="contactsSection" class="contacts-sec" style="margin-top: 0;"></div>
                </div>

                <!-- Tab View: Recent Calls History -->
                <div id="tabContentHistory" class="tab-view-content">
                    <div class="recent-calls-sec">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                            <div class="recent-calls-title">
                                <%= isRtl ? 'سجل المكالمات الأخيرة' : 'Recent Calls' %>
                            </div>
                            <button type="button" onclick="window.softphoneUi.clearCallLogs()" class="btn btn-secondary text-xs" style="padding: 4px 10px; font-size: 11px; gap: 4px;">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                <span><%= isRtl ? 'مسح السجل' : 'Clear History' %></span>
                            </button>
                        </div>
                        <div class="recent-calls-list" id="callHistoryList"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

        <!-- MODAL: MANAGE ACCOUNTS (SAVED ROSTER & ADD NEW) -->
    <div id="presetModal" class="modal-backdrop hidden">
        <div class="modal-card" style="max-width: 480px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <h3 id="modalPresetTitle" style="font-size: 15px; font-weight: 800; color: var(--accent-color); margin: 0;">
                    <%= isRtl ? 'إدارة الحسابات المحفوظة' : 'Manage Accounts' %>
                </h3>
                <button type="button" onclick="window.softphoneUi.closePresetModal()" style="background: none; border: none; color: var(--text-muted); font-size: 16px; cursor: pointer; padding: 2px;">✕</button>
            </div>

            <!-- Modal Sub-Tabs (Saved Accounts vs Add Account) -->
            <div class="modal-tabs">
                <button type="button" id="modalTabBtnSaved" class="modal-tab-btn active" onclick="window.softphoneUi.switchModalTab('saved')">
                    <%= isRtl ? 'الحسابات المحفوظة (دخول سريع)' : 'Saved Accounts' %>
                </button>
                <button type="button" id="modalTabBtnAdd" class="modal-tab-btn" onclick="window.softphoneUi.switchModalTab('add')">
                    <%= isRtl ? '+ إضافة حساب جديد' : '+ Add Account' %>
                </button>
            </div>

            <!-- Tab 1: Saved Accounts Roster -->
            <div id="modalTabContentSaved" style="display: block;">
                <div id="modalSavedAccountsList" class="saved-accounts-roster"></div>
                <div style="display: flex; justify-content: flex-end;">
                    <button type="button" onclick="window.softphoneUi.closePresetModal()" class="btn btn-secondary text-xs">
                        <%= isRtl ? 'إغلاق' : 'Close' %>
                    </button>
                </div>
            </div>

            <!-- Tab 2: Add / Edit Account Form -->
            <div id="modalTabContentAdd" style="display: none;">
                <input type="hidden" id="presetIdInput">
                <div class="flex flex-col gap-2 mb-3">
                    <div>
                        <label class="text-xs font-bold text-secondary"><%= isRtl ? 'اختر التحويلة من السيرفر:' : 'Select Extension from PBX:' %></label>
                        <select id="presetExtSelect" class="input-text font-mono font-bold mt-1" onchange="window.softphoneUi.onModalExtensionSelected()">
                            <option value=""><%= isRtl ? '-- اختر التحويلة من السيرفر --' : '-- Select PBX Extension --' %></option>
                            <% (typeof extensions !== 'undefined' && Array.isArray(extensions) ? extensions : [{extension: '150', name: '150'}, {extension: '151', name: '151'}]).forEach(function(ext) { %>
                                <option value="<%= ext.extension %>" data-name="<%= ext.name || ext.extension %>">
                                    <%= (ext.name && ext.name !== ext.extension) ? (ext.extension + ' (' + ext.name + ')') : ('Ext ' + ext.extension) %> (<%= ext.tech || 'pjsip' %>)
                                </option>
                            <% }); %>
                        </select>
                    </div>
                    <div>
                        <label class="text-xs font-bold text-secondary"><%= isRtl ? 'اسم الحساب:' : 'Account Label:' %></label>
                        <input type="text" id="presetLabelInput" class="input-text mt-1" placeholder="Office Phone">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-secondary"><%= isRtl ? 'رقم التحويلة:' : 'Extension Number:' %></label>
                        <input type="text" id="presetExtInput" class="input-text font-mono mt-1" placeholder="150">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-secondary"><%= isRtl ? 'كلمة سر التحويلة:' : 'Extension Password / Secret:' %></label>
                        <input type="password" id="presetSecretInput" class="input-text font-mono mt-1" placeholder="••••••••">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-secondary"><%= isRtl ? 'نطاق الخادم (Domain/IP):' : 'SIP Domain / Host IP:' %></label>
                        <input type="text" id="presetDomainInput" class="input-text font-mono mt-1" placeholder="192.168.100.128">
                    </div>
                    <div>
                        <label class="text-xs font-bold text-secondary"><%= isRtl ? 'رابط WebSocket (WSS):' : 'WebSocket WSS URL:' %></label>
                        <input type="text" id="presetWssInput" class="input-text font-mono mt-1" placeholder="wss://192.168.100.128:8089/ws">
                    </div>
                    <label style="display: flex; align-items: center; gap: 6px; font-size: 11px; cursor: pointer; margin-top: 4px;">
                        <input type="checkbox" id="presetAutoConnectCheckbox" checked style="accent-color: var(--accent-color);">
                        <span style="font-weight: 700;"><%= isRtl ? 'حفظ كلمة السر والدخول التلقائي فور الاختيار' : 'Save password & auto-login on select' %></span>
                    </label>
                    <label style="display: flex; align-items: center; gap: 6px; font-size: 11px; cursor: pointer;">
                        <input type="checkbox" id="presetDefaultCheckbox" style="accent-color: var(--accent-color);">
                        <span style="font-weight: 700;"><%= isRtl ? 'تعيين كحساب افتراضي' : 'Set as default account' %></span>
                    </label>
                </div>
                <div class="flex items-center justify-between gap-2">
                    <button type="button" onclick="window.softphoneUi.deleteCurrentPreset(); window.softphoneUi.closePresetModal();" class="btn btn-danger text-xs">
                        <%= isRtl ? 'حذف' : 'Delete' %>
                    </button>
                    <div class="flex gap-2">
                        <button type="button" onclick="window.softphoneUi.switchModalTab('saved')" class="btn btn-secondary text-xs">
                            <%= isRtl ? 'إلغاء' : 'Cancel' %>
                        </button>
                        <button type="button" onclick="window.softphoneUi.savePresetFromModal()" class="btn btn-primary text-xs">
                            <%= isRtl ? 'حفظ' : 'Save' %>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL: TRANSFER CALL -->
    <div id="transferModal" class="modal-backdrop hidden">
        <div class="modal-card">
            <h3 style="font-size: 15px; font-weight: 800; margin-bottom: 12px; color: var(--accent-color);">
                <%= isRtl ? 'تحويل المكالمة' : 'Transfer Call' %>
            </h3>
            <input type="hidden" id="transferCallIdInput">
            <div class="mb-3">
                <label class="text-xs font-bold text-secondary"><%= isRtl ? 'الرقم الهدف للتحويل:' : 'Target Extension / Number:' %></label>
                <input type="text" id="transferTargetInput" class="input-text font-mono mt-1" placeholder="102">
            </div>

            <!-- Quick PBX Extensions Roster Grid -->
            <div style="font-size: 11px; font-weight: 700; color: var(--text-muted); margin-bottom: 6px; text-transform: uppercase;">
                <%= isRtl ? 'أو اختر تحويلة من السيرفر:' : 'Or Select Extension:' %>
            </div>
            <div id="transferExtList" class="transfer-ext-list"></div>

            <div class="flex items-center justify-end gap-2">
                <button type="button" onclick="window.softphoneUi.closeTransferModal()" class="btn btn-secondary text-xs">
                    <%= isRtl ? 'إلغاء' : 'Cancel' %>
                </button>
                <button type="button" onclick="window.softphoneUi.executeBlindTransfer()" class="btn btn-primary text-xs">
                    <%= isRtl ? 'تحويل' : 'Transfer' %>
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL: AUDIO HARDWARE DEVICES -->
    <div id="audioModal" class="modal-backdrop hidden">
        <div class="modal-card">
            <h3 style="font-size: 15px; font-weight: 800; margin-bottom: 12px; color: var(--accent-color);">
                <%= isRtl ? 'إعدادات أجهزة الصوت' : 'Audio & Device Settings' %>
            </h3>
            <div class="flex flex-col gap-2 mb-3">
                <div>
                    <label class="text-xs font-bold text-secondary"><%= isRtl ? 'ميكروفون الإدخال:' : 'Microphone Input:' %></label>
                    <select id="audioInputSelect" class="input-text mt-1"></select>
                </div>
                <div>
                    <label class="text-xs font-bold text-secondary"><%= isRtl ? 'سماعة الإخراج:' : 'Speaker Output:' %></label>
                    <select id="audioOutputSelect" class="input-text mt-1"></select>
                </div>
            </div>
            <div class="flex items-center justify-between">
                <button type="button" onclick="window.softphoneUi.testSpeakerOutput()" class="btn btn-secondary text-xs">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="display:inline;vertical-align:middle;margin-right:3px;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
                    <span><%= isRtl ? 'اختبار الصوت' : 'Test Audio' %></span>
                </button>
                <button type="button" onclick="document.getElementById('audioModal').classList.add('hidden')" class="btn btn-primary text-xs">
                    <%= isRtl ? 'تم' : 'Done' %>
                </button>
            </div>
        </div>
    </div>
