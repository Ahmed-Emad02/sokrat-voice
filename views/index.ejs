                window.sokratTelephonyHost.minimize();
                return;
            }
            if (window.parent && window.parent !== window) {
                window.parent.postMessage({ version: 1, type: 'sokrat.voice.collapse' }, '*');
                return;
            }
            window.postMessage({ version: 1, type: 'sokrat.voice.collapse' }, '*');
        }

